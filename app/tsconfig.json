{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "//": "The logic tests are compiled separately by tsconfig.test.json, which gives them Node types. Excluding them here keeps `npm run typecheck` about the app.",
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "testbuild", "src/logic/__tests__"]
}
