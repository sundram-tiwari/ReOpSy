# Copy to app/.env. Everything here is PUBLIC: it is compiled into the app bundle.
# Never put a service-account key or any other secret in this file.
# Restart `expo start` after changing it; env vars are read at bundle time.
# Leave the Firebase values blank to run offline on the bundled feed.

# Firebase web config: Firebase console > Project settings > Your apps > Web app
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Email of the super admin who can open Mission Control
EXPO_PUBLIC_ADMIN_EMAIL=

# Where your hosted legal documents live. Trailing slash required.
EXPO_PUBLIC_LEGAL_BASE_URL=https://yourname.github.io/reopsy/legal/
