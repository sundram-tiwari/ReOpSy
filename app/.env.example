# Copy to app/.env. Everything here is PUBLIC — it is compiled into the bundle.
# Never put a service_role key or any secret in this file.
# Restart `expo start` after changing it; env vars are read at bundle time.

# Leave both blank to stay in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where your hosted legal documents live. Trailing slash required.
EXPO_PUBLIC_LEGAL_BASE_URL=https://yourname.github.io/reopsy/legal/

# Shown on the About and Detail screens for takedown requests.
EXPO_PUBLIC_TAKEDOWN_EMAIL=you@example.com
