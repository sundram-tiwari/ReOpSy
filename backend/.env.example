# Copy to backend/.env and fill in. Never commit .env.
# Every value is optional: without LLM keys the pipeline keeps original titles,
# and without Firebase credentials it skips Firestore feed sync and logging.

# --- LLM providers, tried in this order (any one is enough) ---
GEMINI_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# --- Firebase Admin: feed sync, run and usage logs, admin pipeline queue ---
# Service-account JSON on a single line (Firebase console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# --- Webhook server ---
# Shared secret the scheduler sends as "Authorization: Bearer <secret>"
WEBHOOK_SECRET=
PORT=3000

# --- Legacy V1 nightly ingest only (backend/ingest/ingest.js -> Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# OpenAlex asks for a contact address so they can reach you if a script
# misbehaves; it also puts you in their faster "polite pool".
OPENALEX_MAILTO=you@example.com
