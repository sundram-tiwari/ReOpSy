# Copy to .env and fill in. NEVER commit .env.
# Supabase -> Project Settings -> API

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# service_role key. Server-side only. Do not put this in the app.
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# OpenAlex asks for a contact address in the User-Agent so they can reach you
# if a script misbehaves. It also puts you in their faster "polite pool".
OPENALEX_MAILTO=you@example.com
